{
    // Example of debug configuration for VS Code. Copy this file to .vscode/launch.json and substitute $HOST_PROJECT_PATH.

    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Leetup PHP",
            "type": "php",
            "request": "launch",
            "port": [
                9003,
                9000
            ],
            "pathMappings": {
                "/workspace": "<put value of $HOST_PROJECT_PATH env variable here>"
            }
        },
        {
            "name": "Leetup GO",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "remotePath": "/workspace",
            "port": 2345,
            "host": "127.0.0.1",
            "debugAdapter": "legacy"
        },
        {
            "name": "Leetup JS",
            "port": 9229,
            "request": "attach",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        }
    ]
}