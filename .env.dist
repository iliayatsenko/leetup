# Copy to .env and fill in what differs on this machine. Every value below has a
# default baked into docker-compose.yaml and the scripts, so an .env holding only
# the opencode credentials is enough to get started.

# --- Agents -------------------------------------------------------------------
# AI provider: anthropic, openai etc
OPENCODE_PROVIDER_ID=
# See https://models.dev/ for available providers and models
OPENCODE_MODEL_ID=
# API key for given provider
OPENCODE_API_KEY=

# --- Published ports ----------------------------------------------------------
# Host ports the containers publish. Change them when something else on this
# machine already listens there. The container-side ports never change, so the
# rest of the setup is unaffected
#LEETCODE_API_PORT=3000
#DELVE_PORT=40000
#NODE_INSPECT_PORT=9229
#MYSQL_PORT=3306

# --- Xdebug -------------------------------------------------------------------
# Where Xdebug reaches the IDE listener from inside the container. Docker Desktop
# resolves host.docker.internal; on plain Linux add
#   extra_hosts: ["host.docker.internal:host-gateway"]
# to the leetup service, or point this at the docker0 address instead
#XDEBUG_CLIENT_HOST=host.docker.internal
#XDEBUG_CLIENT_PORT=9003

# --- IDE identifiers ----------------------------------------------------------
# Name of the PhpStorm/VSCode server entry holding the /workspace path mapping,
# must match what the IDE is configured with
#PHP_IDE_SERVER_NAME=leetup
