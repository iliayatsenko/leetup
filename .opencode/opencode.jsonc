{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "{env:OPENCODE_PROVIDER_ID}": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    }
  },
  "model": "{env:OPENCODE_MODEL_ID}",
  // Commands can't carry their own permissions, so this one policy covers all of them:
  // no shell, and edits only to the files the test and hint skills write
  "permission": {
    "question": "deny",
    "bash": "deny",
    "edit": {
      "*": "deny",
      "*/solution_test.*": "allow",
      "*/hints/hint*.md": "allow"
    }
  }
}
