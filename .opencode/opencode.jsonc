{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "{env:OPENCODE_PROVIDER_ID}": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    }
  },
  "model": "{env:OPENCODE_MODEL_ID}",
  "small_model": "{env:OPENCODE_SMALL_MODEL_ID}",
  "permission": {
    "question": "deny"
  },
  "agent": {
    "leetup-test-generator": {
      "model": "{env:OPENCODE_SMALL_MODEL_ID}",
      "permission": {
        "bash": "deny"
      }
    },
    "leetup-reviewer": {
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "leetup-hint-generator": {
      "permission": {
        "bash": "deny"
      }
    }
  }
}